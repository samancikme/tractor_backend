# Namuna. Haqiqiy qiymatlar bilan ".env" nomli fayl yarating (".env" GitHub'ga yuklanmaydi).
# Lokal ishga tushirish:  node --env-file=.env server.js

# Lokal port (Render'da PORT'ni Render o'zi beradi, o'zingiz o'rnatmang).
PORT=3000

# ESP32-CAM yuboradigan Bearer token. Bo'sh qoldirilsa, /upload tokensiz ishlaydi (faqat lokal test uchun!).
# Kuchli token yaratish:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Render'da bu qiymatni Dashboard -> Environment bo'limiga kiriting.
API_TOKEN=

# MongoDB ulanish URI manzili (masalan MongoDB Atlas yoki lokal MongoDB).
# Ko'rsatilmasa, server avtomatik ravishda operativ xotirada (RAM) ishlaydi.
MONGODB_URI=mongodb://localhost:27017/esp32_cam

# Ixtiyoriy: Ma'lumotlar bazasi nomi (agar URI ichida ko'rsatilmagan bo'lsa)
# MONGODB_DB_NAME=esp32_cam

# Ixtiyoriy: dekodlash uchun maksimal piksel soni (standart 8000000 = 8 megapiksel).
# MAX_PIXELS=8000000

# Ixtiyoriy: JPEG tekshiruvi qattiqligi: truncated | error (standart) | warning
# "warning" ESP32-CAM'ning ozgina shikastlangan kadrlarini ham rad etadi.
# JPEG_FAIL_ON=error

